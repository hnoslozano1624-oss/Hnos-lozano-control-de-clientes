{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hnos-lozano-control-de-clientes",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "build": { "command": "node build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/_blob/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "dl-control-clientes", "database_id": "8f498b8b-43e6-4608-ac67-0b04d9da3233" }
  ],
  "keep_vars": true
}
